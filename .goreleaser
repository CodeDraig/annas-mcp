version: 2
project_name: annas-cli

before:
  hooks:
    - go mod tidy
    - go generate ./...
builds:
  - id: annas-cli
    main: ./cmd/annas-cli
    ldflags:
      - -extldflags "-static" -s -w -X github.com/iosifache/annas-mcp/internal/version.version={{.Version}}
    env:
      - CGO_ENABLED=0
    goos:
      - linux
      - freebsd
      - darwin
    goarch:
      - amd64
      - arm64
      - arm
    goarm:
      - "7"
    ignore:
      - goos: freebsd
        goarch: arm64
      - goos: freebsd
        goarch: arm
      - goos: darwin
        goarch: arm

  - id: annas-cli-win
    main: ./cmd/annas-cli
    ldflags:
      - -extldflags "-static" -s -w -X github.com/iosifache/annas-mcp/internal/version.version={{.Version}}
    env:
      - CGO_ENABLED=0
    goos:
      - windows
    goarch:
      - amd64
      - arm64

archives:
  - name_template: "{{ .ProjectName }}_{{ .Version }}_{{ .Os }}_{{ .Arch }}"
    formats:
      - tar.xz
    format_overrides:
      - goos: windows
        formats:
          - zip
    wrap_in_directory: true
    files:
      - README.md

checksum:
  name_template: "{{ .ProjectName }}_{{ .Version }}--checksums.txt"

release:
  draft: false

changelog:
  sort: asc
